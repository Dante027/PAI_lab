<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomePantry.Views.CategoriesPage"
             Title="Kategorie">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Kategorie produktów"
                   Style="{StaticResource HeaderLabelStyle}" />

            <Label Text="Wybierz produkt, aby zobaczyć szczegóły:"
                   FontSize="16"
                   HorizontalOptions="Center" />

            <Button Text="Mleko 3,2%" Clicked="OnMlekoClicked" />
            <Button Text="Chleb żytni" Clicked="OnChlebClicked" />
            <Button Text="Kurczak filet" Clicked="OnKurczakClicked" />
            <Button Text="Jabłka Gala" Clicked="OnJablkaClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
